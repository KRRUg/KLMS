<!DOCTYPE html>
<html lang="de">
	<head>
    	<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-M7KCFVXM');</script>
		<!-- End Google Tag Manager -->
		{% if app.request.pathInfo == '/content/support' %}
			<script src="https://desk.zoho.eu/portal/api/feedbackwidget/189051000000274310?orgId=20103009939&displayType=embeded"></script>
		{% endif %}
		{% if app.request.pathInfo == '/register' %}
			<script src="https://www.google.com/recaptcha/api.js" async defer></script>
		{% endif %}
		{% if app.request.pathInfo starts with '/shop/payment' %}
			<script src="https://gateway.sumup.com/gateway/ecom/card/v2/sdk.js"></script>
		{% endif %}
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<meta http-equiv="cache-control" content="no-cache"/>
		{% block favicon %}<link rel="shortcut icon" href="{{ asset('favicon.ico') }}"/>
		{% endblock %}
		<title>
			{% block title %}
				{{ settings.get('site.title') }}
			{% endblock %}
		</title>
		{% block stylesheets %}
			<link rel="stylesheet" id="us-fonts-css" href="https://fonts.googleapis.com/css?family=Open+Sans%3A400%2C700%7CMontserrat+Alternates%3A700&amp;display=swap&amp;ver=6.6.2" media="all">
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
	</head>
	<body>
    	<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M7KCFVXM"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		{% if (settings.get('site.prepage.show') == "1" and not (app.request.pathInfo starts with '/admin' or app.request.pathInfo == '/login' or app.request.pathInfo == '/reset'))  %}
			<div class="container mt-4">
				{{ settings.get('site.prepage.text')|raw }}
			</div>
		{% else %}
			{% block body %}{% endblock %}
		{% endif %}
		<footer id="footer">
			{% block sponsor %}
				<div class="">
					{% include 'site/components/sponsoring.html.twig' %}
				</div>
			{% endblock %}
			{% block footer %}
				<div class="">
					{% include 'site/components/footer.html.twig' %}
				</div>
			{% endblock %}
			{% block footbar %}
				<div class="">
					{% include 'site/components/footBar.html.twig' %}
				</div>
			{% endblock %}
		</footer>
		{% block javascripts %}
				{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
