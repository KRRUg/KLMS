<nav id="main-nav" class="navbar fixed-top navbar-expand-xl navbar-dark">
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#main-nav-content" aria-controls="main-nav-content" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <a href="/"><img class="header-logo" src="{{ asset("build/images/logo-header-menu.png") }}"/></a>
    <div class="collapse navbar-collapse" id="main-nav-content">        
	<ul class="navbar-nav mr-auto">
            {% set root = nav.renderNavByName('main_menu') %}
            {% if root is empty or root['children'] is empty %}
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                {% else %}
                {% for node in root['children'] %}
                    {% set name = node['name'] %}
                    {% set path = node['path'] %}
                    {% set children = node['children'] %}
                    {% set active_route = app.request.pathInfo %}
                    {% if children is empty %}
                        <li class="nav-item">
                            <a class="nav-link{% if (active_route == path) %} active{% endif %}" href="{{ path | default('#') }}">{{ name }}</a>
                        </li>
                    {% else %}
                        {# determine if any child is active #}
                        {% set parent_active = false %}
                        {% for childNode in children %}
                            {% if active_route == childNode['path'] %}
                                {% set parent_active = true %}
                            {% endif %}
                        {% endfor %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle{% if parent_active %} active{% endif %}" href="{{ path | default('#') }}" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ name }}</a>
                            <ul class="dropdown-menu">
                                {% for childNode in children %}
                                    <li>
                                        <a class="dropdown-item{% if active_route == childNode['path'] %} active{% endif %}" href="{{ childNode['path'] | default('#') }}">{{ childNode['name'] }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endif %}
                {% endfor %}
            {% endif %}
            {# User/Login dropdown - only visible in collapsed (mobile) state #}
            <li class="nav-item nav-only-collapsed">
                {% if app.user.user is defined %}
                    {% include 'site/components/topBar/userDropdown.html.twig' %}
                {% else %}
                    {% include 'site/components/topBar/loginDropdown.html.twig' %}
                {% endif %}
            </li>
        </ul>
    </div>
    {% include 'site/components/topBar.html.twig' %}
</nav>