<div class="card mb-3 h-100">
    <div class="row no-gutters h-100">
        <div class="col-sm-4 col-lg-2 bg-darker text-light text-center">
            <div class="d-flex flex-column align-items-center justify-content-start pt-3">
                {% block cardImage %}
                    {% if cardImg is defined and cardImg is not empty %}
                        <img src='{{ cardImg | imagine_filter('user_img') }}' class="img-fluid rounded-circle border" style="max-width: 150px; width: 150px; height: 150px; object-fit: cover;" alt="Profilbild" />
                    {% elseif cardSymbol is defined and cardSymbol is not empty %}
                        <div class="my-3">
                            <i class="{{ cardSymbol }} text-white"></i>
                        </div>
                    {% else %}
                        <i class="fas fa-user-circle" style="font-size: 150px;"></i>
                    {% endif %}
                {% endblock %}
            </div>
        </div>
        <div class="col-sm-8 col-lg-10">
            <div class="card-body">
                {% block cardBody %}{% endblock %}
            </div>
        </div>
    </div>
</div>