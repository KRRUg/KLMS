{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - Buchungen - {{ resource.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('booking') }}
{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row mb-3">
        <div class="col-12 d-flex align-items-center">
            <a class="btn btn-secondary" href="{{ path('booking') }}"><i class="fas fa-arrow-left"></i> Zurück zur Übersicht</a>
            <h1 class="h3 mb-0 ml-3">{{ resource.name }}</h1>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            {% if resource.description %}
                <p>{{ resource.description }}</p>
            {% endif %}
            <p class="text-muted mb-1"><small><i class="fas fa-layer-group"></i> {{ resource.unitCount }} parallel vorhanden</small></p>
            <p class="text-muted mb-1"><small><i class="far fa-clock"></i> Slotdauer: {{ resource.slotDurationMinutes }} min</small></p>         
            {% if resource.bufferMinutes > 0 %}
                <p class="text-muted mb-0"><small><i class="fas fa-stopwatch"></i> Puffer zwischen Buchungen: {{ resource.bufferMinutes }} min</small></p>
            {% endif %}
            <p class="text-muted mb-1"><small><i class="fas fa-user-check"></i> Pro Person buchbar: {{ resource.maxBookingsPerUser is null ? 'unbegrenzt' : resource.maxBookingsPerUser }}x</small></p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card">
                    <h4 class="mt-2 mb-0">Verfügbare Slots</h5>
                </div>
                <div class="card-body">
                    {% if slots %}
                        {% set currentDay = null %}
                        {% for slot in slots %}
                            {% set slotDay = slot.start|date('Y-m-d') %}
                            {% if slotDay != currentDay %}
                                {% if currentDay is not null %}
                                    </div>
                                {% endif %}

                                <h6 class="mt-3 mb-2">{{ slot.start|date('d.m.Y') }}</h6>
                                <div class="booking-slot-list mb-2">
                                {% set currentDay = slotDay %}
                            {% endif %}

                            <form method="post" action="{{ path('booking_book', {'id': resource.id}) }}" class="d-inline-block mb-2 mr-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('booking_action') }}">
                                <input type="hidden" name="start" value="{{ slot.start|date('c') }}">
                                <button type="submit" class="btn btn-sm booking-slot-btn {{ slot.free > 0 ? 'btn-outline-success' : 'btn-outline-secondary' }}" {{ slot.free > 0 ? '' : 'disabled' }}>
                                    {{ slot.start|date('H:i') }} - {{ slot.end|date('H:i') }} ({{ slot.free }}/{{ slot.total }})
                                </button>
                            </form>

                            {% if loop.last %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <p class="text-muted mb-0">Aktuell keine Zeiten verfügbar.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
