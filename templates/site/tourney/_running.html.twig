{% from 'site/tourney/show.html.twig' import teamnameA, teamnameB %}

{% macro enter_result_button(game = null, form = null) %}
    {% if game is not null %}
        <button class="btn btn-primary btn-sm btn-block" type="button" {% if game.pending %} data-toggle="modal" data-target="#result-modal-{{ game.id }}" {% else %} disabled="disabled"{% endif %}><i class="fa-solid fa-square-poll-horizontal"></i> Ergebnis eintragen</button>
        {% if form is not null %}
            {% include 'site/tourney/_running.modal.html.twig' with { id : 'result-modal-' ~ game.id, form: form, game: game } %}
        {% endif %}
    {% endif %}
{% endmacro %}

{% extends 'site/tourney/_card.body.html.twig' %}

{% block blockButtonBarMain %}
{% endblock %}

{% block mainColTop %}
    {% set pendingGames = (current_games | default([])) | filter(g => g.isPending()) %}
    {% if tm | default(null) is not null %}
        <div class="col-12 mb-3">
            {% if pendingGames is not empty %}
                {% if pendingGames | length > 1 %}
                    <div class="text-center h4 mb-3 mt-3"><strong>Ausstehende Spiele</strong></div>
                {% else %}
                    <div class="text-center h4 mb-3 mt-3"><strong>Ausstehendes Spiel</strong></div>
                {% endif %}
                {% set resultForms = forms[constant('App\\Controller\\Site\\TourneyController::FORM_NAME_RESULT')] | default([]) %}
                {% for game in pendingGames %}
                    <div class="row align-items-center mb-3">
                        <div class="col">
                            {% include 'site/tourney/_team.card.html.twig' with {team: game.teamA} %}
                        </div>
                        <div class="col-auto">
                            <span class="h4">VS</span>
                        </div>
                        <div class="col">
                            {% include 'site/tourney/_team.card.html.twig' with {team: game.teamB} %}
                        </div>
                    </div>
                    {% if participates %}
                        <div class="text-right mb-3">
                            {{ _self.enter_result_button(game, resultForms[game.id] ?? null) }}
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                {% if current_games | default([]) is empty and tourney.hasTree %}
                    {% set finalGame = tourney.games | filter(g => g.parent is null and not g.isGroupStage()) | first %}
                    {% if finalGame is not null and finalGame.isDone() and finalGame.getWinner() == tm.team %}
                        <div class="alert alert-success mb-3"><i class="fa-solid fa-trophy"></i> Herzlichen Glückwunsch, du hast das Turnier gewonnen!</div>
                    {% elseif tourney.groupCount > 0 and tm.team.groupKey is not null and (hasIncompleteGroupGames | default(false)) %}
                        <div class="alert alert-info mb-3"><i class="fa-solid fa-hourglass-half"></i> Alle eigenen Gruppenspiele beendet. Warte auf andere Ergebnisse...</div>
                    {% else %}
                        <div class="alert alert-danger mb-3">Du bist nicht mehr im Rennen!</div>
                    {% endif %}
                {% endif %}
                {% if not tourney.singlePlayer %}
                    {% include 'site/tourney/_team.card.html.twig' with {team: tm.team} %}
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}