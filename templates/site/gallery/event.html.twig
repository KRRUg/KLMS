{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ eventName }} - Galerie - {{ parent() }}{% endblock %}

{% block main %}
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('gallery') }}">
                            <i class="fas fa-images me-1"></i> Galerie
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        {{ eventName }}
                    </li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4>
                        <i class="fas fa-calendar-alt me-3"></i>
                        {{ eventName }}
                        <small class="text-muted">({{ photos|length }} Bilder)</small>
                    </h4>
                </div>
            </div>
            
            {% if photos is empty %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Keine Bilder für dieses Event gefunden.
                </div>
            {% else %}
                <div class="row g-3">
                    {% for photo in photos %}
                        <div class="col-6 col-md-4 col-lg-3 mb-4">
                            <div class="card border-0">
                                <a href="{{ photo.getImagePath() }}" 
                                   class="glightbox" 
                                   data-gallery="{{ eventName }}"
                                   data-title="{{ photo.title ?? 'Bild ' ~ photo.uuid }}"
                                   data-description="{{ photo.description ?? '' }}">
                                    <img src="{{ photo.getImagePath()|imagine_filter('gallery_thumb') }}"
                                         alt="{{ photo.title ?? 'Bild ' ~ photo.uuid }}"
                                         class="card-img-top"
                                         loading="lazy"
                                         style="height: 200px; object-fit: cover;">
                                </a>
                                
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# GLightbox CSS #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    {# GLightbox JS #}
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    
    {# Gallery functionality #}
    {{ encore_entry_script_tags('gallery') }}
{% endblock %}