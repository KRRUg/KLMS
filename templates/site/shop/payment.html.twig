{% extends 'site/siteBase.html.twig' %}

{% block title %}Zahlung - {{ parent() }}{% endblock %}

{% block main %}
<div class="container mb-4">
            <h1 class="text-center">Zahlung</h1>
            <p>Du kannst deine Bestellung bequem, schnell und sicher via Kredit- oder Debitkarte bezahlen. Nach der Bezahlung wird dein Ticket sofort freigeschaltet. Wenn du das nicht möchtest, klicke unten auf "Später bezahlen oder überweisen".</p>
            {% if order %}
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Bestellung #{{ order.id }}</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Bestellnummer:</strong></div>
                            <div class="col-sm-9">{{ order.id }}</div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Datum:</strong></div>
                            <div class="col-sm-9">{{ order.createdAt|date('d.m.Y H:i') }}</div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Status:</strong></div>
                            <div class="col-sm-9">
                                {% if order.isOpen %}
                                    <span class="p-1 badge-primary">nicht bezahlt</span>
                                {% elseif order.isPaid %}
                                    <span class="p-1 badge-success">bezahlt</span>
                                {% elseif order.isCanceled %}
                                    <span class="p-1 badge-danger">storniert</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Gesamtbetrag:</strong></div>
                            <div class="col-sm-9">{{ (order.calculateTotal() / 100)|number_format(2, ',', '.') }} €</div>       
                    </div>
                </div>

                {% if checkoutId %}
                    <div class="card">   
                    	<div class="d-flex justify-content-start">
                            <div id="sumup-card"></div>
                          
                        </div>
                          <div class="mt-3 small">
                                <p>Deine Zahlung wird sicher über SumUp verarbeitet.</p>
                            </div>

                    </div>

                    <script
                      type="text/javascript"
                      src="https://gateway.sumup.com/gateway/ecom/card/v2/sdk.js"
                    ></script>
                    <script type="text/javascript">
                      SumUpCard.mount({
                        id: 'sumup-card',
                        checkoutId: '{{ checkoutId }}',
                        locale: 'de-DE',
                        onResponse: function (type, body) {
                          console.log('Type', type);
                          console.log('Body', body);
                          
                          if (type === 'success') {
                            window.location.href = '{{ path('shop_payment_verify') }}?checkoutId=' + body.id;
                          } else if (type === 'error') {
                            alert('Fehler bei der Zahlung: ' + (body.message || 'Unbekannter Fehler'));
                          }
                        },
                      });
                    </script>
                {% endif %}

                <div class="mt-4">
                    <a href="{{ path('shop_orders') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i> Später bezahlen oder überweisen
                    </a>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    Keine offene Bestellung gefunden.
                </div>
                <a href="{{ path('shop_orders') }}" class="btn btn-primary"> Zu den Bestellungen</a>
            {% endif %}
</div>
{% endblock %}