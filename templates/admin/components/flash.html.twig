
{% set flashMessages = (app.request is defined and app.request is not null and app.request.isXmlHttpRequest)
    ? {}
    : app.flashes(['success', 'info', 'warning', 'danger', 'error']) %}

{% for label, messages in flashMessages %}
    {% for message in messages %}
        {% set bootstrapLabel = label == 'error' ? 'danger' : label %}
        <div class="alert alert-{{ bootstrapLabel }} alert-dismissible fade show d-block">
            <span class="badge badge-{{ bootstrapLabel }} text-uppercase">{{ label }}</span>
            {{ message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
{% endfor %}