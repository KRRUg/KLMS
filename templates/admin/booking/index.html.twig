{% extends 'admin/adminBase.html.twig' %}

{% block title %}Buchungen - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-calendar-check"></i> Buchungen{% endblock %}

{% block main %}
<div class="row mb-4">
    <div class="col-12">
        <a class="btn btn-success" href="{{ path('admin_booking_new') }}">
            <i class="fas fa-plus"></i> Ressource anlegen
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        {% if resources %}
        <div class="card">
            <table class="table table-striped admin-data-table">
                <thead>
                <tr>
                    <th scope="col" style="width: 2em;" class="text-center">&#8470;</th>
                    <th scope="col" style="width: 2em;" class="text-center">
                        <i title="Aktiv" class="fas fa-eye"></i>
                    </th>
                    <th scope="col" style="width: 2em;" class="text-center">
                        <i title="Reihenfolge" class="fa-solid fa-arrow-up-1-9"></i>
                    </th>
                    <th scope="col" style="width: auto">Name</th>
                    <th scope="col" style="width: 6em;" class="text-center">Einheiten</th>
                    <th scope="col" style="width: 8em;" class="text-center">Slot-Dauer</th>
                    <th scope="col" style="width: 7em;" class="text-center">Puffer</th>
                    <th scope="col" style="width: 8.5em;" class="text-center">Buchbar von</th>
                    <th scope="col" style="width: 8.5em;" class="text-center">Buchbar bis</th>
                    <th scope="col" style="width: 12em;" class="text-center">Aktionen</th>
                </tr>
                </thead>
                <tbody>
                {% for resource in resources %}
                    <tr>
                        <td class="text-center">{{ resource.id }}</td>
                        <td class="text-center" data-order="{{ resource.active ? 1 : 0 }}">
                            <form method="post" action="{{ path('admin_booking_toggle', {'id': resource.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_toggle) }}">
                                <button type="submit" class="btn btn-link p-0" title="Status ändern">
                                    {% if resource.active %}
                                        <i class="fas fa-eye text-success" title="aktiv"></i>
                                    {% else %}
                                        <i class="fas fa-eye-slash text-danger" title="inaktiv"></i>
                                    {% endif %}
                                </button>
                            </form>
                        </td>
                        <td class="text-center">{{ resource.priority }}</td>
                        <td>
                            <a href="{{ path('admin_booking_edit', {'id': resource.id}) }}" class="text-decoration-none">
                                {{ resource.name }}
                            </a>
                        </td>
                        <td class="text-center">{{ resource.unitCount }}</td>
                        <td class="text-center">{{ resource.slotDurationMinutes }} min</td>
                        <td class="text-center">{{ resource.bufferMinutes }} min</td>
                        <td class="text-center" data-order="{{ resource.availableFrom|date('U') }}">{{ resource.availableFrom|date('d.m.Y H:i') }}</td>
                        <td class="text-center" data-order="{{ resource.availableUntil|date('U') }}">{{ resource.availableUntil|date('d.m.Y H:i') }}</td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a href="{{ path('admin_booking_reservations', {'id': resource.id}) }}" class="btn btn-sm btn-outline-primary" title="Buchungen ansehen">
                                    <i class="fas fa-list"></i> Buchungen
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card">
            <div class="card-body text-center text-muted">
                <i class="fas fa-calendar-check fa-3x mb-3"></i>
                <h5>Keine Ressourcen vorhanden</h5>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
