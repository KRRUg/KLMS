{% extends 'admin/adminBase.html.twig' %}

{% block title %}KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-users"></i> Clan Discount {% endblock %}
{% block main %}
    <div class="row">
        <div class="col">
            <div class="card mb-4">
                <div class="card-body">
                    {{ form_start(form) }}
                        {{ form_row(form.clanId) }}
                        {{ form_row(form.price) }}
                    <div class="float-right">
                        <a class="btn btn-secondary" href="{{ path('admin_clandiscount') }}">Abbrechen</a>
                        <button type="submit" id="clandiscount_save" class="btn-primary btn">Speichern</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
