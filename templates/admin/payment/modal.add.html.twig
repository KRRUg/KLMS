{% embed "modules/modals/form.html.twig"
    with {
    'id': 'newModal',
    'title' : 'Gamer anmelden',
    'attr' : {'data-backdrop': 'static'},
    'button_save' : 'Anmelden',
    'form' : form_register
}
%}
    {% block modalForm %}
        {{ form_row(form_register.user) }}
        {{ form_row(form_register.comment) }}
    {% endblock %}
{% endembed %}

