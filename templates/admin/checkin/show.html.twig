{% extends 'admin/adminBase.html.twig' %}

{% block title %}KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-shipping-fast"></i>Express CheckIn: {{ user.nickname }}{% endblock %}
{% block main %}
    {% set dateformat = "d.m.Y H:i" %}
    {% set data = ticketCheckinForm.vars.data %}
    <div class="clearfix mb-4">
        {% if not ticketCheckinForm.vars.valid %}
            <div class="alert alert-error">
                {{ form_errors(ticketCheckinForm) }}
            </div>
        {% endif %}

        {# TODO: Render Ticket and User Details #}
        {# NEW Layout #}
        <div class="row">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                {% set img = user | user_image %}
                                {% if img is not empty %}
                                    <img src="{{ img | imagine_filter('user_img') }}" alt="Image of {{ user|username }}"/>
                                {% else %}
                                    <i class="far fa-user-circle fa-8x"></i>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <i class="fas fa-headset fa-fw mr-2" title="Name"></i>
                                <h1 title="Nickname: {{ user.nickname }}"
                                    class="h3 d-inline-block">{{ user.nickname|defaultBadge('Nickname n.v.') }}</h1>
                                <br>
                                <i class="fas fa-signature fa-fw mr-2" title="Name"></i>
                                <h2 class="h4 d-inline-block">
                                    <span title="Vorname: {{ user.firstname }}">{{ user.firstname|defaultBadge('Vorname n.v.') }}</span>
                                    <span title="Nachname: {{ user.surname }}">{{ user.surname|defaultBadge('Nachname n.v.') }}</span>
                                </h2>
                                <p>
                                    <i class="far fa-envelope fa-fw mr-2"
                                       title="E-Mail Adresse"></i>{{ user.email|defaultBadge('E-Mailadresse n.v.') }}
                                </p>
                                <p>
                                    <i class="fas fa-mobile-alt fa-fw mr-2"
                                       title="Telefonnummer"></i>{{ user.phone|defaultBadge(' n.v. ') }}
                                </p>
                                <h2 class="h4 d-inline-block badge badge-info" style="font-size: 100%">
                                    <i class="fas fa-chair fa-fw mr-2"
                                       title="Sitzplatz"></i>{{ user | seat }}
                                </h2>

                                <h2 class="h4 d-inline-block badge {% if user is age_below(18) %}badge-danger{% else%}badge-info{% endif%} float-right" style="font-size: 100%">
                                    <i class="fas fa-cake fa-fw mr-2"
                                       title="Geburtsdatum"></i>
                                    {% if user.birthdate is not empty %}
                                        <strong>Alter: {{ user.birthdate|age }} Jahre</strong>
                                    {% endif %}
                                </h2>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                {# TODO: Show Addons for Ticket/User #}
{#                                <i class="fa fa-plus fa-7x"></i>#}
{#                                <div class="col">#}
{#                                    <p>#}
{#                                        <i class="fas fa-euro fa-fw mr-2" title="Käufer"></i>#}
{#                                        {% if ticket.shopOrderPosition is not empty %}#}
{#                                            <span class="d-inline-block">{{ ticket.shopOrderPosition.order.orderer | username }}</span>#}
{#                                        {% else %}#}
{#                                            <span class="d-inline-block text-muted">nicht gekauft</span>#}
{#                                        {% endif %}#}
{#                                    </p>#}
{#                                </div>#}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <i class="fa fa-ticket fa-7x"></i>
                                <div class="col">
                                    <p>
                                        <i class="fas fa-keyboard fa-fw mr-2" title="Code"></i>
                                        <span title="Number: {{ ticket.code }}" class="d-inline-block text-monospace">{{ ticket.code }}</span>
                                    </p>
                                    <p>
                                        <i class="fas fa-euro fa-fw mr-2" title="Käufer"></i>
                                        {% if ticket.shopOrderPosition is not empty %}
                                            <span class="d-inline-block">{{ ticket.shopOrderPosition.order.orderer | username }}</span>
                                        {% else %}
                                            <span class="d-inline-block text-muted">nicht gekauft</span>
                                        {% endif %}
                                    </p>
                                    <p>
                                        <i class="fas fa-shopping-cart fa-fw mr-2" title="Gekauft"></i>
                                        <span class="d-inline-block">{{ ticket.createdAt | date(dateformat) }}</span>
                                    </p>
                                    <p>
                                        <i class="fas fa-money-check fa-fw mr-2" title="Eingelöst"></i>
                                        {% if ticket.redeemedAt is not empty %}
                                            <span class="d-inline-block">{{ ticket.redeemedAt | date(dateformat) }}</span>
                                        {% else %}
                                            <span class="d-inline-block text-muted">nicht eingelöst</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        Userdaten bestätigen
                    </div>
                    <div class="card-body">
                        {% if not userVerifyForm.vars.valid %}
                            <div class="alert alert-error" role="alert">
                                {{ form_errors(userVerifyForm) }}
                            </div>
                        {% endif %}
                        {% if user.personalDataConfirmed %}
                            <div class="alert alert-success" role="alert">
                                Daten bereits bestätigt!
                            </div>
                        {% endif %}
                        <div data-controller="admin-checkin" data-action="submit->admin-checkin#submitForm">
                            {{ include('admin/checkin/_form.user_verify.html.twig', {'form': userVerifyForm}) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        Catering Band verbinden (optional)
                    </div>
                    {% if klcsEnabled %}
                    <div class="card-body" data-controller="admin-checkin" data-action="submit->admin-checkin#submitForm">
                        {{ include('admin/checkin/_form.klcs_binding.html.twig', {'form': klcsAccountBindingForm}) }}
                    </div>
                    {% else %}
                        <div class="card-body">
                            Diese Funktion ist deaktiviert. <br/>
                            <button type="button" disabled="disabled" class="btn btn-sm mr-1 btn-outline-dark">2) Cateringaccount anlegen
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col">
            </div>
        </div>
        <hr>
        {{ form_start(ticketCheckinForm) }}
        <div class="float-right">
            <a class="btn btn-secondary" href="{{ path('admin_checkin') }}">Abbrechen</a>
            {{ form_widget(ticketCheckinForm.punch, {'label' : '3) Ticket einchecken'}) }}
        </div>
        {{ form_end(ticketCheckinForm) }}
    </div>
{% endblock %}