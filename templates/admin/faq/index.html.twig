{% extends 'admin/adminBase.html.twig' %}

{% block title %}FAQ - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-question-circle"></i> FAQ{% endblock %}

{% block main %}
<div class="row mb-4">
    <div class="col-12">
        <a class="btn btn-success" href="{{ path('admin_faq_new') }}">
            <i class="fas fa-plus"></i> FAQ anlegen
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        {% if faqs %}
        <div class="card">
            <table class="table table-striped admin-data-table">
                <thead>
                <tr>
                    <th scope="col" style="width: 2em;" class="text-center">&#8470;</th>
                    <th scope="col" style="width: 2em;" class="text-center">
                        <i title="Aktiv" class="fas fa-eye"></i>
                    </th>
                    <th scope="col" style="width: 2em;" class="text-center">
                        <i title="Reihenfolge" class="fa-solid fa-arrow-up-1-9"></i>
                    </th>
                    <th scope="col" style="width: auto">Frage</th>
                    <th scope="col" style="width: 10em;" class="text-center">Aktionen</th>
                </tr>
                </thead>
                <tbody>
                {% for faq in faqs %}
                    <tr>
                        <td class="text-center">{{ faq.id }}</td>
                        <td class="text-center" data-order="{{ faq.active ? 1 : 0 }}">
                            <form method="post" action="{{ path('admin_faq_toggle', {'id': faq.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_toggle) }}">
                                <button type="submit" class="btn btn-link p-0" title="Status ändern">
                                    {% if faq.active %}
                                        <i class="fas fa-eye text-success" title="aktiv"></i>
                                    {% else %}
                                        <i class="fas fa-eye-slash text-danger" title="inaktiv"></i>
                                    {% endif %}
                                </button>
                            </form>
                        </td>
                        <td class="text-center">{{ faq.priority }}</td>
                        <td>
                            <a href="{{ path('admin_faq_edit', {'id': faq.id}) }}" class="text-decoration-none">
                                {{ faq.question|length > 80 ? faq.question|slice(0, 80) ~ '...' : faq.question }}
                            </a>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <form method="post" action="{{ path('admin_faq_delete', {'id': faq.id}) }}" style="display: inline;" 
                                      onsubmit="return confirm('Sind Sie sicher, dass Sie diese FAQ löschen möchten?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_delete) }}">
                                    <button type="submit" class="btn btn-outline-danger" title="Löschen">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card">
            <div class="card-body text-center text-muted">
                <i class="fas fa-question-circle fa-3x mb-3"></i>
                <h5>Keine FAQs vorhanden</h5>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}