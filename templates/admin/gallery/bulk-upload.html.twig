{% extends 'admin/adminBase.html.twig' %}

{% block title %}KLMS - Admin
{% endblock %}
{% block siteheading %}
	<i class="fas fa-images fa-fw"></i>
	Mehrere Bilder hochladen
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('admin_gallery') }}
	<script>
		// Set upload URL for JavaScript
window.galleryBulkUploadUrl = '{{ path('admin_gallery_bulk_upload') }}';
	</script>
{% endblock %}

{% block main %}
	<div class="container-fluid mt-4">
		<div class="row justify-content-center">
			<div class="col-md-10">
				<div class="card">
					<div class="card-body">
						<form id="bulkUploadForm" enctype="multipart/form-data">

							<div class="row mb-4">
								<div class="col-md-6">
									<label for="eventSelect" class="form-label">Event auswählen</label>
									<div class="input-group">
										<select id="eventSelect" name="event" class="form-select" required>
											<option value="">-- Event auswählen --</option>
											{% for event in events %}
												<option value="{{ event.name }}">{{ event.name }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>

							<!-- Drag & Drop Area -->
							<div class="mb-4">
								<div id="dropZone" class="border border-2 border-dashed border-primary rounded p-5 text-center bg-light">
									<i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
									<h4>Bilder hierher ziehen oder klicken zum Auswählen</h4>
									<p class="text-muted">
										Unterstützte Formate: JPEG, PNG, GIF, WebP<br>
										Bis zu 100+ Bilder gleichzeitig möglich<br>
										PHP-Limits beachten! Upload-Limits in der php.ini usw.
									</p>
									<input type="file" id="fileInput" name="images[]" multiple accept="image/*" style="display: none;">
									<button type="button" class="btn btn-primary" id="selectFilesBtn">
										<i class="fas fa-folder-open me-2"></i>Bilder auswählen
									</button>
								</div>
							</div>

							<!-- Selected Files List -->
							<div id="filesList" class="mb-4" style="display: none;">
								<h5>
									<i class="fas fa-images me-2"></i> Ausgewählte Bilder
									<span id="fileCount" class="badge bg-primary">0</span>
								</h5>
								<div
									id="filesContainer" class="row g-2" style="max-height: 300px; overflow-y: auto;"><!-- Files will be added here dynamically -->
								</div>
							</div>

							<!-- Progress Bar -->
							<div id="uploadProgress" class="mb-4" style="display: none;">
								<h5>
									<i class="fas fa-spinner fa-spin me-2"></i> Upload läuft...</h5>
								<div class="progress mb-2">
									<div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
								</div>
								<div id="progressText" class="text-center">0 / 0 Bilder hochgeladen</div>
							</div>

							<!-- Results -->
							<div
								id="uploadResults" style="display: none;"><!-- Results will be shown here -->
							</div>

							<div class="float-right">
								<a class="btn btn-secondary" href="{{ path('admin_gallery') }}">Abbrechen / Zurück</a>
								<button type="button" id="clearBtn" class="btn-secondary btn" disabled>
									<i class="fas fa-trash me-2"></i>
									Auswahl löschen
								</button>
								<button type="submit" id="uploadBtn" class="btn-primary btn" disabled>
									<i class="fas fa-cloud-upload-alt me-2"></i>
									Alle hochladen
								</button>
							</div>


						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
