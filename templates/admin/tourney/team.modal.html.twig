{% extends "modules/modals/skeleton.html.twig" %}

{% block modalTitle %}
    {% if team.id %}
    Team bearbeiten: {{ team.name ?? ('Team #' ~ team.id) }}
    {% else %}
        Neues Team erstellen
    {% endif %}
{% endblock %}

{% block modalBody %}
    {{ form_start(form, {'attr': {'id': 'tourney-team-form', 'data-tourney-type': tourney.singlePlayer ? 'single' : 'team'}}) }}
    
    <div class="mb-3">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
        {{ form_errors(form.name) }}
        {% if tourney.singlePlayer %}
            <small class="form-text text-muted">
                Bei 1vs1 Turnieren wird der Teamname automatisch auf den Spielernamen gesetzt.
            </small>
        {% endif %}
    </div>

    <div class="mb-3">
        <label class="form-label">Spieler</label>
        
        {% if tourney.singlePlayer %}
            {# Für 1vs1 nur einen Spieler auswählen #}
            <div class="mb-2">
                {{ form_widget(form.singlePlayer) }}
                {{ form_errors(form.singlePlayer) }}
            </div>
        {% else %}
            {% set memberPrototype %}
                <div class="member-item border rounded p-3 mb-2">
                    <div class="row align-items-center">
                        <div class="col">
                            {{ form_widget(form.members.vars.prototype.gamer, {'attr': {'class': 'form-control', 'data-user-select': '1'}}) }}
                            {{ form_errors(form.members.vars.prototype.gamer) }}
                        </div>
                        <div class="col-auto">
                            <div class="form-check mt-2 mt-md-0">
                                {{ form_widget(form.members.vars.prototype.accepted, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.members.vars.prototype.accepted, 'Bestätigt', {'label_attr': {'class': 'form-check-label mb-0 ml-1'}}) }}
                            </div>
                        </div>
                        <div class="col-auto mt-2 mt-md-0">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-member" title="Spieler entfernen">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            {% endset %}

          <div id="members-container"
              data-prototype="{{ memberPrototype|e('html_attr') }}"
              data-max-size="{{ (tourney.rules.teamSize ?? '') }}">
                {% for memberForm in form.members %}
                    <div class="member-item border rounded p-3 mb-2">
                        <div class="row align-items-center">
                            <div class="col">
                                {{ form_widget(memberForm.gamer, {'attr': {'class': 'form-control', 'data-user-select': '1'}}) }}
                                {{ form_errors(memberForm.gamer) }}
                            </div>
                            <div class="col-auto">
                                <div class="form-check mt-2 mt-md-0">
                                    {{ form_widget(memberForm.accepted, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(memberForm.accepted, 'Bestätigt', {'label_attr': {'class': 'form-check-label mb-0 ml-1'}}) }}
                                </div>
                            </div>
                            <div class="col-auto mt-2 mt-md-0">
                                <button type="button" class="btn btn-outline-danger btn-sm remove-member" title="Spieler entfernen">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <button type="button" id="add-member" class="btn btn-sm btn-outline-success">
                <i class="fa-solid fa-plus"></i> Spieler hinzufügen
            </button>

            <small class="form-text text-muted d-block mt-2">
                Maximale Teamgröße: {{ (tourney.rules.teamSize ?? 'Unbegrenzt') }}
            </small>
        {% endif %}
    </div>
{% endblock %}

{% block modalFooter %}
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
    <button type="submit" class="btn btn-success" data-original-text="{% if team.id %}Aktualisieren{% else %}Erstellen{% endif %}" form="tourney-team-form">
        <i class="fas fa-save"></i>
        {% if team.id %}Aktualisieren{% else %}Erstellen{% endif %}
    </button>
    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('admin_tourney') }}
{% endblock %}