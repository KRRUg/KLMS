{% import 'admin/tourney/helpers/_macros.html.twig' as m %}

<div class="card shadow-sm">
    <div class="card-body d-flex flex-wrap align-items-center">
        <div>
            <h1 class="h4 mb-1">{{ tourney.name }}</h1>
            <p class="mb-0 text-muted">Token: {{ tourney.token }} • Reihenfolge: {{ tourney.order }}</p>
        </div>
        <div class="ml-auto d-flex flex-wrap align-items-center" style="gap: .5rem;">
            <a href="{{ path('admin_tourney') }}" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="fa-solid fa-arrow-left"></i> Zurück zur Übersicht
            </a>
            {% include 'admin/tourney/helpers/_status_actions.html.twig' %}
        </div>
    </div>
</div>
