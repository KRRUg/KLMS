<div class="mb-3 d-flex align-items-center" data-form-collection-target="item" style="gap: 0.75rem;">
    <div class="flex-grow-1">
        {{ form_widget(memberForm.gamer) }}
        {{ form_errors(memberForm.gamer) }}
    </div>
    <div class="d-flex align-items-center">
        {{ form_widget(memberForm.accepted, {'attr': {'class': 'mr-2'}}) }}
        {{ form_label(memberForm.accepted) }}
    </div>
    <button type="button" class="btn btn-outline-danger btn-sm" data-action="form-collection#remove" title="Mitglied entfernen">
        <i class="fa-solid fa-trash"></i>
    </button>
</div>